<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="plist-cil" />
    <PackageReference Include="Zeroconf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\mDNSDiscovery.Core\mDNSDiscovery.Core.csproj" />
    <ProjectReference Include="..\mDNSDiscovery.ServiceDefaults\mDNSDiscovery.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DeviceInfo / ServiceEndpoint / ServiceCatalog live in mDNSDiscovery.Core; surface them
         project-wide so the Services, Parsers, and Razor components compile without per-file usings. -->
    <Using Include="mDNSDiscovery.Core" />
  </ItemGroup>

</Project>
