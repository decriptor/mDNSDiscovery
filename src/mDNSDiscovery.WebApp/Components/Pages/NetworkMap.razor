@page "/network-map"
@using mDNSDiscovery.WebApp.Services
@using Microsoft.JSInterop
@inject MdnsDiscoveryService DiscoveryService
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Network Map · mDNS Discovery</PageTitle>

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="bi bi-diagram-3" aria-hidden="true"></i> Network Topology Map</h3>
        <div class="btn-group" role="group">
            <button class="btn btn-sm btn-outline-primary" @onclick="RefreshMap">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleGrouping">
                <i class="bi bi-collection" aria-hidden="true"></i> @(GroupBySubnet ? "Ungroup" : "Group by Subnet")
            </button>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    <h5 class="card-title">@TotalDevices</h5>
                    <p class="card-text text-muted">Total Devices</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    <h5 class="card-title">@UniqueSubnets</h5>
                    <p class="card-text text-muted">Subnets</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    <h5 class="card-title">@TotalServices</h5>
                    <p class="card-text text-muted">Services</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    <h5 class="card-title">@UniqueVendors</h5>
                    <p class="card-text text-muted">Vendors</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Network Map Canvas -->
    <div class="card">
        <div class="card-body">
            <div id="network-map-container" class="network-map-container">
                <canvas id="network-canvas" class="network-map-canvas"></canvas>
                <div id="network-tooltip" class="network-map-tooltip" style="display: none;"></div>
            </div>
        </div>
    </div>

    <!-- Keyboard-accessible device list (fallback for the mouse-only canvas above) -->
    <details class="card mt-3" open>
        <summary class="card-header" style="cursor: pointer;">
            <i class="bi bi-list-ul" aria-hidden="true"></i> Device List
            <span class="text-muted small">(keyboard-accessible alternative to the map above)</span>
        </summary>
        <div class="card-body p-0">
            @if (DeviceListEntries.Count > 0)
            {
                <div class="list-group list-group-flush">
                    @foreach (var entry in DeviceListEntries)
                    {
                        <a href="/device/@entry.DeviceId" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span>
                                <strong>@entry.Name</strong>
                                <span class="text-muted"> &middot; @entry.IPAddress</span>
                                @if (!string.IsNullOrEmpty(entry.Vendor) && entry.Vendor != "Unknown")
                                {
                                    <span class="badge bg-secondary vendor-badge">@entry.Vendor</span>
                                }
                            </span>
                            <span class="badge bg-info rounded-pill">@entry.ServiceCount service@(entry.ServiceCount == 1 ? "" : "s")</span>
                        </a>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0 p-3">No devices discovered yet.</p>
            }
        </div>
    </details>

    <!-- Legend -->
    <div class="card mt-3">
        <div class="card-header">
            <h6 class="mb-0"><i class="bi bi-info-circle" aria-hidden="true"></i> Legend</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="d-flex align-items-center mb-2">
                        <div style="width: 20px; height: 20px; background: #0d6efd; border-radius: 50%; margin-right: 8px;"></div>
                        <span>Apple Devices</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="d-flex align-items-center mb-2">
                        <div style="width: 20px; height: 20px; background: #198754; border-radius: 50%; margin-right: 8px;"></div>
                        <span>Google Devices</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="d-flex align-items-center mb-2">
                        <div style="width: 20px; height: 20px; background: #dc3545; border-radius: 50%; margin-right: 8px;"></div>
                        <span>Printers/Scanners</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="d-flex align-items-center mb-2">
                        <div style="width: 20px; height: 20px; background: #6c757d; border-radius: 50%; margin-right: 8px;"></div>
                        <span>Other Devices</span>
                    </div>
                </div>
            </div>
            <div class="alert alert-info mt-3 mb-0">
                <i class="bi bi-lightbulb" aria-hidden="true"></i>
                <strong>Tip:</strong> Click on a device to view details. Drag to pan, scroll to zoom. Use the
                Device List above for keyboard-only or screen-reader access.
            </div>
        </div>
    </div>

    <!-- Subnet List -->
    <div class="card mt-3">
        <div class="card-header">
            <h6 class="mb-0"><i class="bi bi-diagram-2" aria-hidden="true"></i> Subnets</h6>
        </div>
        <div class="card-body">
            @if (SubnetGroups.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Subnet</th>
                                <th>Device Count</th>
                                <th>Service Count</th>
                                <th>IP Range</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var subnet in SubnetGroups.OrderByDescending(s => s.Value.Count()))
                            {
                                var devices = subnet.Value.ToList();
                                var firstIp = devices.First().IPAddress;
                                var lastIp = devices.Last().IPAddress;
                                var serviceCount = devices.SelectMany(d => d.Endpoints).Count() + devices.Count;

                                <tr>
                                    <td><code>@subnet.Key</code></td>
                                    <td>@devices.Count</td>
                                    <td>@serviceCount</td>
                                    <td><small>@firstIp - @lastIp</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No devices discovered yet.</p>
            }
        </div>
    </div>
</div>

@code {
    private IJSObjectReference? _jsModule;
    private bool GroupBySubnet = true;
    private int TotalDevices = 0;
    private int UniqueSubnets = 0;
    private int TotalServices = 0;
    private int UniqueVendors = 0;
    private Dictionary<string, IEnumerable<DeviceInfo>> SubnetGroups = new();
    private List<NetworkMapDeviceEntry> DeviceListEntries = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/network-map.js");
            await RefreshMap();
        }
    }

    private async Task RefreshMap()
    {
        var devices = DiscoveryService.GetDevices().ToList();

        // Calculate statistics
        TotalDevices = devices.GroupBy(d => d.IPAddress).Count();
        TotalServices = devices.Count;

        SubnetGroups = devices
            .GroupBy(d => GetSubnet(d.IPAddress))
            .ToDictionary(g => g.Key, g => g.AsEnumerable());

        UniqueSubnets = SubnetGroups.Count;

        UniqueVendors = devices
            .Select(d => DeviceIconHelper.GetDeviceVendor(d))
            .Where(v => !string.IsNullOrEmpty(v))
            .Distinct()
            .Count();

        StateHasChanged();

        if (_jsModule != null)
        {
            // Prepare network data for visualization
            var networkData = PrepareNetworkData(devices);
            await _jsModule.InvokeVoidAsync("renderNetworkMap", networkData, GroupBySubnet);
        }
    }

    private async Task ToggleGrouping()
    {
        GroupBySubnet = !GroupBySubnet;
        await RefreshMap();
    }

    private string GetSubnet(string ipAddress)
    {
        var parts = ipAddress.Split('.');
        if (parts.Length == 4)
        {
            return $"{parts[0]}.{parts[1]}.{parts[2]}.0/24";
        }
        return "Unknown";
    }

    private object PrepareNetworkData(List<DeviceInfo> devices)
    {
        var nodes = new List<object>();
        var links = new List<object>();
        var deviceEntries = new List<NetworkMapDeviceEntry>();
        var subnetHubsSeen = new HashSet<string>();

        // Central hub that every subnet connects to, so the map always shows
        // devices linked back to a gateway rather than floating in isolation.
        const string rootHubId = "hub:root";
        nodes.Add(new
        {
            id = rootHubId,
            label = "Network",
            ip = "",
            vendor = "",
            deviceType = "hub",
            subnet = "",
            serviceCount = 0,
            services = "",
            color = "#495057",
            size = 24,
            isHub = true
        });

        // Group by IP to avoid duplicates
        var deviceGroups = devices.GroupBy(d => d.IPAddress).ToList();

        foreach (var group in deviceGroups)
        {
            var primaryDevice = group.OrderByDescending(d => d.LastSeen).First();
            var vendor = DeviceIconHelper.GetDeviceVendor(primaryDevice);
            var deviceType = DeviceIconHelper.GetDeviceType(primaryDevice);
            var subnet = GetSubnet(primaryDevice.IPAddress);

            // Determine node color based on vendor/type
            var color = GetNodeColor(vendor, deviceType);

            var serviceCount = group.Count();
            var serviceTypes = string.Join(", ", group.Select(d =>
                d.ServiceType.Replace("._tcp.local.", "").Replace("._udp.local.", "").Replace("_", " ").Trim('.')
            ).Take(3));

            var subnetHubId = $"hub:{subnet}";
            if (subnetHubsSeen.Add(subnet))
            {
                nodes.Add(new
                {
                    id = subnetHubId,
                    label = subnet,
                    ip = "",
                    vendor = "",
                    deviceType = "hub",
                    subnet = subnet,
                    serviceCount = 0,
                    services = "",
                    color = "#6c757d",
                    size = 20,
                    isHub = true
                });
                links.Add(new { source = rootHubId, target = subnetHubId });
            }

            var deviceId = Uri.EscapeDataString($"{primaryDevice.Name}_{primaryDevice.IPAddress}");

            nodes.Add(new
            {
                id = primaryDevice.IPAddress,
                label = primaryDevice.Name,
                ip = primaryDevice.IPAddress,
                vendor = vendor ?? "Unknown",
                deviceType = deviceType,
                subnet = subnet,
                serviceCount = serviceCount,
                services = serviceTypes,
                color = color,
                size = Math.Min(14 + serviceCount * 2, 28), // Small nodes; grow modestly with service count
                isHub = false
            });

            links.Add(new { source = subnetHubId, target = primaryDevice.IPAddress });

            deviceEntries.Add(new NetworkMapDeviceEntry(
                primaryDevice.Name,
                primaryDevice.IPAddress,
                vendor ?? "Unknown",
                subnet,
                serviceCount,
                deviceId));
        }

        DeviceListEntries = deviceEntries
            .OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        return new { nodes, links };
    }

    private string GetNodeColor(string? vendor, string deviceType)
    {
        if (vendor?.Contains("Apple") == true) return "#0d6efd"; // Blue
        if (vendor?.Contains("Google") == true) return "#198754"; // Green
        if (deviceType.Contains("Printer") || deviceType.Contains("Scanner")) return "#dc3545"; // Red
        if (vendor?.Contains("Philips") == true) return "#fd7e14"; // Orange
        if (vendor?.Contains("Sonos") == true) return "#6610f2"; // Purple
        return "#6c757d"; // Gray
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // JavaScript side already disconnected
            }
        }
    }

    private sealed record NetworkMapDeviceEntry(
        string Name,
        string IPAddress,
        string Vendor,
        string Subnet,
        int ServiceCount,
        string DeviceId);
}
