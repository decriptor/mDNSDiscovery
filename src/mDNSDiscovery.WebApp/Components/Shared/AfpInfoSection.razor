@using mDNSDiscovery.WebApp.Services.Parsers

@if (HasMatches)
{
    <div class="border rounded p-3 mb-3">
        <h5 class="d-flex align-items-center gap-2">
            <i class="bi bi-folder-symlink"></i>
            AFP File Sharing
            @if (AfpInfo.Available)
            {
                <span class="badge bg-success">Available</span>
            }
        </h5>

        <div class="mt-3">
            @if (!string.IsNullOrEmpty(AfpInfo.MachineName))
            {
                <div class="mb-2">
                    <strong>Server Name:</strong> @AfpInfo.MachineName
                </div>
            }

            @if (!string.IsNullOrEmpty(AfpInfo.Model))
            {
                <div class="mb-2">
                    <strong>Model:</strong> @AfpInfo.Model
                </div>
            }

            @if (AfpInfo.DecodedCapabilities.Any())
            {
                <div class="mb-2">
                    <strong>Capabilities:</strong>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var cap in AfpInfo.DecodedCapabilities)
                        {
                            <span class="badge bg-info">@cap</span>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(AfpInfo.Version))
            {
                <div class="mb-2">
                    <strong>AFP Version:</strong> <code>@AfpInfo.Version</code>
                </div>
            }

            @if (AfpInfo.Port > 0)
            {
                <div class="mb-2">
                    <strong>Port:</strong> <code>@AfpInfo.Port</code>
                </div>
            }

            @if (AfpInfo.Properties.Any())
            {
                <details class="mt-3">
                    <summary class="text-muted" style="cursor: pointer;">
                        <small>All Properties (@AfpInfo.Properties.Count)</small>
                    </summary>
                    <div class="mt-2">
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Key</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prop in AfpInfo.Properties.OrderBy(p => p.Key))
                                {
                                    <tr>
                                        <td><code>@prop.Key</code></td>
                                        <td><code>@prop.Value</code></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }

            <div class="alert alert-info mt-3 mb-0">
                <i class="bi bi-info-circle"></i>
                <strong>About AFP:</strong> Apple Filing Protocol - macOS native file sharing protocol
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public AfpInfo AfpInfo { get; set; } = null!;
    [Parameter] public string? SearchTerm { get; set; }

    private bool HasMatches
    {
        get
        {
            if (AfpInfo == null) return false;
            if (string.IsNullOrWhiteSpace(SearchTerm)) return true;

            var term = SearchTerm.ToLowerInvariant();

            return AfpInfo.MachineName?.ToLowerInvariant().Contains(term) == true ||
                   AfpInfo.Model?.ToLowerInvariant().Contains(term) == true ||
                   AfpInfo.Version?.ToLowerInvariant().Contains(term) == true ||
                   AfpInfo.DecodedCapabilities.Any(c => c.ToLowerInvariant().Contains(term)) ||
                   AfpInfo.Properties.Any(p => p.Key.ToLowerInvariant().Contains(term) ||
                                               p.Value.ToLowerInvariant().Contains(term));
        }
    }
}
