@using mDNSDiscovery.WebApp.Services
@using mDNSDiscovery.WebApp.Services.Parsers

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-speaker"></i> AirPlay Audio (RAOP)</h5>
    </div>
    <div class="card-body">
        @if (!HasMatches && !string.IsNullOrWhiteSpace(SearchTerm))
        {
            <div class="alert alert-warning mb-0">
                <i class="bi bi-search"></i> No matches found for "<strong>@SearchTerm</strong>"
            </div>
        }
        else
        {
            <dl class="row mb-0">
                @if (!string.IsNullOrEmpty(RaopInfo.DeviceType))
                {
                    <dt class="col-sm-4">Device Type</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-primary">@RaopInfo.DeviceType</span>
                    </dd>
                }
                @if (!string.IsNullOrEmpty(RaopInfo.DeviceModel))
                {
                    <dt class="col-sm-4">Device Model</dt>
                    <dd class="col-sm-8">@RaopInfo.DeviceModel</dd>
                }
                @if (!string.IsNullOrEmpty(RaopInfo.ModelName))
                {
                    <dt class="col-sm-4">Model Name</dt>
                    <dd class="col-sm-8">@RaopInfo.ModelName</dd>
                }
                @if (RaopInfo.Port > 0)
                {
                    <dt class="col-sm-4">RAOP Port</dt>
                    <dd class="col-sm-8">@RaopInfo.Port</dd>
                }
                @if (!string.IsNullOrEmpty(RaopInfo.ServerVersion))
                {
                    <dt class="col-sm-4">Server Version</dt>
                    <dd class="col-sm-8">@RaopInfo.ServerVersion</dd>
                }
                @if (RaopInfo.PasswordRequired)
                {
                    <dt class="col-sm-4">Password</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-warning"><i class="bi bi-lock"></i> Required</span>
                    </dd>
                }
                @if (!string.IsNullOrEmpty(RaopInfo.AudioChannels))
                {
                    <dt class="col-sm-4">Audio Channels</dt>
                    <dd class="col-sm-8">@RaopInfo.AudioChannels</dd>
                }
                @if (!string.IsNullOrEmpty(RaopInfo.SampleRate))
                {
                    <dt class="col-sm-4">Sample Rate</dt>
                    <dd class="col-sm-8">@RaopInfo.SampleRate Hz</dd>
                }
                @if (!string.IsNullOrEmpty(RaopInfo.SampleSize))
                {
                    <dt class="col-sm-4">Sample Size</dt>
                    <dd class="col-sm-8">@RaopInfo.SampleSize bits</dd>
                }
                @if (RaopInfo.DecodedCompressionTypes.Any())
                {
                    <dt class="col-sm-4">Audio Codecs</dt>
                    <dd class="col-sm-8">
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var compression in RaopInfo.DecodedCompressionTypes)
                            {
                                <span class="badge bg-info">@compression</span>
                            }
                        </div>
                    </dd>
                }
                @if (RaopInfo.EncryptionSupported.Any())
                {
                    <dt class="col-sm-4">Encryption</dt>
                    <dd class="col-sm-8">
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var encryption in RaopInfo.EncryptionSupported)
                            {
                                <span class="badge bg-secondary">@encryption</span>
                            }
                        </div>
                    </dd>
                }
                @if (RaopInfo.DecodedFeatures.Any())
                {
                    <dt class="col-sm-4">Supported Features</dt>
                    <dd class="col-sm-8">
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var feature in RaopInfo.DecodedFeatures)
                            {
                                <span class="badge bg-success">@feature</span>
                            }
                        </div>
                    </dd>
                }
                @if (RaopInfo.DecodedFeatureFlags.Any())
                {
                    <dt class="col-sm-4">Audio Capabilities</dt>
                    <dd class="col-sm-8">
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var flag in RaopInfo.DecodedFeatureFlags)
                            {
                                <span class="badge bg-success">@flag</span>
                            }
                        </div>
                    </dd>
                }
            </dl>

            @if (RaopInfo.Properties.Any())
            {
                <details class="mt-3">
                    <summary class="text-primary" style="cursor: pointer;">View All TXT Record Properties</summary>
                    <div class="table-responsive mt-2">
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Property</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prop in RaopInfo.Properties.OrderBy(p => p.Key))
                                {
                                    <tr>
                                        <td><code style="font-size: 0.85rem;">@prop.Key</code></td>
                                        <td>@prop.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }

            <div class="alert alert-info mt-3 mb-0">
                <i class="bi bi-info-circle"></i>
                <strong>About RAOP:</strong> Remote Audio Output Protocol (RAOP) is the protocol used by AirPlay
                for streaming audio from iOS/macOS devices to AirPlay-compatible speakers and receivers.
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public RaopInfo RaopInfo { get; set; } = null!;

    [Parameter]
    public string SearchTerm { get; set; } = string.Empty;

    private bool HasMatches
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchTerm))
                return true;

            var searchLower = SearchTerm.ToLowerInvariant();

            if (RaopInfo.DeviceType?.ToLowerInvariant().Contains(searchLower) == true ||
                RaopInfo.DeviceModel?.ToLowerInvariant().Contains(searchLower) == true ||
                RaopInfo.ModelName?.ToLowerInvariant().Contains(searchLower) == true ||
                RaopInfo.ServerVersion?.ToLowerInvariant().Contains(searchLower) == true ||
                RaopInfo.AudioChannels?.ToLowerInvariant().Contains(searchLower) == true ||
                RaopInfo.SampleRate?.ToLowerInvariant().Contains(searchLower) == true ||
                RaopInfo.SampleSize?.ToLowerInvariant().Contains(searchLower) == true)
            {
                return true;
            }

            if (RaopInfo.DecodedCompressionTypes.Any(c => c.ToLowerInvariant().Contains(searchLower)) ||
                RaopInfo.EncryptionSupported.Any(e => e.ToLowerInvariant().Contains(searchLower)) ||
                RaopInfo.DecodedFeatures.Any(f => f.ToLowerInvariant().Contains(searchLower)) ||
                RaopInfo.DecodedFeatureFlags.Any(f => f.ToLowerInvariant().Contains(searchLower)))
            {
                return true;
            }

            foreach (var prop in RaopInfo.Properties)
            {
                if (prop.Key.ToLowerInvariant().Contains(searchLower) ||
                    prop.Value.ToLowerInvariant().Contains(searchLower))
                {
                    return true;
                }
            }

            return false;
        }
    }
}
