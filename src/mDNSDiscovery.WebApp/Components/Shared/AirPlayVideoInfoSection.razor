@using mDNSDiscovery.WebApp.Services.Parsers

@if (HasMatches)
{
    <div class="border rounded p-3 mb-3">
        <h5 class="d-flex align-items-center gap-2">
            <i class="bi bi-play-circle"></i>
            AirPlay Video
            @if (AirPlayVideoInfo.Available)
            {
                <span class="badge bg-success">Available</span>
            }
        </h5>

        <div class="mt-3">
            @if (!string.IsNullOrEmpty(AirPlayVideoInfo.DeviceType))
            {
                <div class="mb-2">
                    <strong>Device Type:</strong>
                    <span class="badge bg-primary">@AirPlayVideoInfo.DeviceType</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(AirPlayVideoInfo.Model))
            {
                <div class="mb-2">
                    <strong>Model:</strong> @AirPlayVideoInfo.Model
                </div>
            }

            @if (AirPlayVideoInfo.Width.HasValue && AirPlayVideoInfo.Height.HasValue)
            {
                <div class="mb-2">
                    <strong>Display Resolution:</strong> @AirPlayVideoInfo.Width x @AirPlayVideoInfo.Height
                </div>
            }

            @if (AirPlayVideoInfo.SupportsVideo || AirPlayVideoInfo.SupportsAudio || AirPlayVideoInfo.SupportsPhoto)
            {
                <div class="mb-2">
                    <strong>Capabilities:</strong>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @if (AirPlayVideoInfo.SupportsVideo)
                        {
                            <span class="badge bg-info">
                                <i class="bi bi-camera-video"></i> Video
                            </span>
                        }
                        @if (AirPlayVideoInfo.SupportsAudio)
                        {
                            <span class="badge bg-info">
                                <i class="bi bi-volume-up"></i> Audio
                            </span>
                        }
                        @if (AirPlayVideoInfo.SupportsPhoto)
                        {
                            <span class="badge bg-info">
                                <i class="bi bi-image"></i> Photo
                            </span>
                        }
                    </div>
                </div>
            }

            @if (AirPlayVideoInfo.DecodedFeatures.Any())
            {
                <div class="mb-2">
                    <strong>Features:</strong>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var feature in AirPlayVideoInfo.DecodedFeatures)
                        {
                            <span class="badge bg-success">@feature</span>
                        }
                    </div>
                </div>
            }

            @if (AirPlayVideoInfo.PasswordRequired || AirPlayVideoInfo.RequiresPassword)
            {
                <div class="mb-2">
                    <span class="badge bg-warning">
                        <i class="bi bi-lock"></i> Password Required
                    </span>
                </div>
            }

            @if (!string.IsNullOrEmpty(AirPlayVideoInfo.SourceVersion))
            {
                <div class="mb-2">
                    <strong>Source Version:</strong> <code>@AirPlayVideoInfo.SourceVersion</code>
                </div>
            }

            @if (!string.IsNullOrEmpty(AirPlayVideoInfo.DeviceId))
            {
                <div class="mb-2">
                    <strong>Device ID:</strong> <code class="small">@AirPlayVideoInfo.DeviceId</code>
                </div>
            }

            @if (AirPlayVideoInfo.Port > 0)
            {
                <div class="mb-2">
                    <strong>Port:</strong> <code>@AirPlayVideoInfo.Port</code>
                </div>
            }

            @if (AirPlayVideoInfo.Properties.Any())
            {
                <details class="mt-3">
                    <summary class="text-muted" style="cursor: pointer;">
                        <small>All Properties (@AirPlayVideoInfo.Properties.Count)</small>
                    </summary>
                    <div class="mt-2">
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Key</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prop in AirPlayVideoInfo.Properties.OrderBy(p => p.Key))
                                {
                                    <tr>
                                        <td><code>@prop.Key</code></td>
                                        <td><code>@prop.Value</code></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        </div>
    </div>
}

@code {
    [Parameter] public AirPlayVideoInfo AirPlayVideoInfo { get; set; } = null!;
    [Parameter] public string? SearchTerm { get; set; }

    private bool HasMatches
    {
        get
        {
            if (AirPlayVideoInfo == null) return false;
            if (string.IsNullOrWhiteSpace(SearchTerm)) return true;

            var term = SearchTerm.ToLowerInvariant();

            return AirPlayVideoInfo.DeviceType?.ToLowerInvariant().Contains(term) == true ||
                   AirPlayVideoInfo.Model?.ToLowerInvariant().Contains(term) == true ||
                   AirPlayVideoInfo.SourceVersion?.ToLowerInvariant().Contains(term) == true ||
                   AirPlayVideoInfo.DeviceId?.ToLowerInvariant().Contains(term) == true ||
                   AirPlayVideoInfo.DecodedFeatures.Any(f => f.ToLowerInvariant().Contains(term)) ||
                   AirPlayVideoInfo.Properties.Any(p => p.Key.ToLowerInvariant().Contains(term) ||
                                                         p.Value.ToLowerInvariant().Contains(term));
        }
    }
}
