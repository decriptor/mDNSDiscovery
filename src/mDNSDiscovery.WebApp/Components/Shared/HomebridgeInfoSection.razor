@using mDNSDiscovery.WebApp.Services.Parsers

@if (HasMatches(HomebridgeInfo))
{
    <div class="border rounded p-3 mb-3">
        <h5 class="d-flex align-items-center gap-2">
            <i class="bi bi-house-gear"></i>
            Homebridge
            @if (HomebridgeInfo?.Available == true)
            {
                <span class="badge bg-success">Available</span>
            }
        </h5>

        @if (HomebridgeInfo != null)
        {
            @if (HomebridgeInfo.Available)
            {
                <div class="mt-3">
                    @if (!string.IsNullOrEmpty(HomebridgeInfo.BridgeName))
                    {
                        <div class="mb-2">
                            <strong>Bridge Name:</strong> @HomebridgeInfo.BridgeName
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(HomebridgeInfo.HomebridgeVersion))
                    {
                        <div class="mb-2">
                            <strong>Homebridge Version:</strong> <code>@HomebridgeInfo.HomebridgeVersion</code>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(HomebridgeInfo.PluginCount))
                    {
                        <div class="mb-2">
                            <strong>Plugin Count:</strong>
                            <span class="badge bg-info">@HomebridgeInfo.PluginCount plugin(s)</span>
                        </div>
                    }

                    @if (HomebridgeInfo.Port > 0)
                    {
                        <div class="mb-2">
                            <strong>Port:</strong> <code>@HomebridgeInfo.Port</code>
                        </div>
                    }

                    @if (HomebridgeInfo.Properties.Any())
                    {
                        <details class="mt-3">
                            <summary class="text-muted" style="cursor: pointer;">
                                <small>All Properties (@HomebridgeInfo.Properties.Count)</small>
                            </summary>
                            <div class="mt-2">
                                <table class="table table-sm table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Key</th>
                                            <th>Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var prop in HomebridgeInfo.Properties.OrderBy(p => p.Key))
                                        {
                                            <tr>
                                                <td><code>@prop.Key</code></td>
                                                <td><code>@prop.Value</code></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }

                    <div class="alert alert-info mt-3 mb-0">
                        <i class="bi bi-info-circle"></i>
                        Homebridge is a platform that bridges HomeKit to non-HomeKit smart home devices
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning mt-3 mb-0">
                    <i class="bi bi-exclamation-triangle"></i>
                    Homebridge service detected but not available
                </div>
            }
        }
    </div>
}

@code {
    [Parameter] public HomebridgeInfo? HomebridgeInfo { get; set; }
    [Parameter] public string? SearchTerm { get; set; }

    private bool HasMatches(HomebridgeInfo? info)
    {
        if (info == null) return false;

        if (string.IsNullOrWhiteSpace(SearchTerm))
            return true;

        var term = SearchTerm.ToLowerInvariant();

        return info.BridgeName?.ToLowerInvariant().Contains(term) == true ||
               info.HomebridgeVersion?.ToLowerInvariant().Contains(term) == true ||
               info.PluginCount?.ToLowerInvariant().Contains(term) == true ||
               info.Properties.Any(p => p.Key.ToLowerInvariant().Contains(term) || p.Value.ToLowerInvariant().Contains(term));
    }
}
