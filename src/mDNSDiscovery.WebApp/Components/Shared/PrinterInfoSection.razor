@using mDNSDiscovery.WebApp.Services
@using mDNSDiscovery.WebApp.Services.Parsers

@if (HasMatches)
{
    <div class="border rounded p-3 mb-3">
        <h5 class="d-flex align-items-center gap-2">
            <i class="bi bi-printer"></i>
            Printer
            @if (PrinterInfo.Available)
            {
                <span class="badge bg-success">Available</span>
            }
        </h5>

        <div class="mt-3">
            @if (!string.IsNullOrEmpty(PrinterInfo.DeviceType))
            {
                <div class="mb-2">
                    <strong>Device Type:</strong> @PrinterInfo.DeviceType
                </div>
            }

            @if (!string.IsNullOrEmpty(PrinterInfo.Manufacturer))
            {
                <div class="mb-2">
                    <strong>Manufacturer:</strong> @PrinterInfo.Manufacturer
                </div>
            }

            @if (!string.IsNullOrEmpty(PrinterInfo.Model))
            {
                <div class="mb-2">
                    <strong>Model:</strong> @PrinterInfo.Model
                </div>
            }

            @if (!string.IsNullOrEmpty(PrinterInfo.Product))
            {
                <div class="mb-2">
                    <strong>Product:</strong> @PrinterInfo.Product
                </div>
            }

            @if (!string.IsNullOrEmpty(PrinterInfo.Note))
            {
                <div class="mb-2">
                    <strong>Location/Note:</strong> @PrinterInfo.Note
                </div>
            }

            @if (!string.IsNullOrEmpty(PrinterInfo.AdminUrl))
            {
                <div class="mb-2">
                    <strong>Admin URL:</strong>
                    <a href="@PrinterInfo.AdminUrl" target="_blank" class="text-decoration-none">
                        @PrinterInfo.AdminUrl <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
            }

            @if (!string.IsNullOrEmpty(PrinterInfo.IppEndpoint))
            {
                <div class="mb-2">
                    <strong>IPP Endpoint:</strong>
                    <a href="@PrinterInfo.IppEndpoint" target="_blank" class="text-decoration-none">
                        @PrinterInfo.IppEndpoint <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
            }

            @if (PrinterInfo.SupportsColor || PrinterInfo.SupportsDuplex || PrinterInfo.SupportsScan || PrinterInfo.SupportsFax)
            {
                <div class="mb-2">
                    <strong>Capabilities:</strong>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @if (PrinterInfo.SupportsColor)
                        {
                            <span class="badge bg-info">
                                <i class="bi bi-palette"></i> Color
                            </span>
                        }
                        @if (PrinterInfo.SupportsDuplex)
                        {
                            <span class="badge bg-info">
                                <i class="bi bi-arrow-down-up"></i> Duplex
                            </span>
                        }
                        @if (PrinterInfo.SupportsScan)
                        {
                            <span class="badge bg-info">
                                <i class="bi bi-scanner"></i> Scan
                            </span>
                        }
                        @if (PrinterInfo.SupportsFax)
                        {
                            <span class="badge bg-info">
                                <i class="bi bi-telephone"></i> Fax
                            </span>
                        }
                    </div>
                </div>
            }

            @if (PrinterInfo.SupportedFormats.Any())
            {
                <div class="mb-2">
                    <strong>Supported Formats (PDL):</strong>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var format in PrinterInfo.SupportedFormats)
                        {
                            <span class="badge bg-secondary">@format</span>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(PrinterInfo.PrinterState))
            {
                <div class="mb-2">
                    <strong>Printer State:</strong> <code>@PrinterInfo.PrinterState</code>
                </div>
            }

            @if (!string.IsNullOrEmpty(PrinterInfo.ResourcePath))
            {
                <div class="mb-2">
                    <strong>Resource Path:</strong> <code>@PrinterInfo.ResourcePath</code>
                </div>
            }

            @if (PrinterInfo.QueueTotal.HasValue)
            {
                <div class="mb-2">
                    <strong>Queue Size:</strong> @PrinterInfo.QueueTotal
                </div>
            }

            @if (!string.IsNullOrEmpty(PrinterInfo.UUID))
            {
                <div class="mb-2">
                    <strong>UUID:</strong> <code class="small">@PrinterInfo.UUID</code>
                </div>
            }

            @if (PrinterInfo.Port > 0)
            {
                <div class="mb-2">
                    <strong>Port:</strong> <code>@PrinterInfo.Port</code>
                </div>
            }

            @if (PrinterInfo.Properties.Any())
            {
                <details class="mt-3">
                    <summary class="text-muted" style="cursor: pointer;">
                        <small>All Properties (@PrinterInfo.Properties.Count)</small>
                    </summary>
                    <div class="mt-2">
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Key</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prop in PrinterInfo.Properties.OrderBy(p => p.Key))
                                {
                                    <tr>
                                        <td><code>@prop.Key</code></td>
                                        <td><code>@prop.Value</code></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public PrinterInfo PrinterInfo { get; set; } = null!;

    [Parameter]
    public string SearchTerm { get; set; } = string.Empty;

    private bool HasMatches
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchTerm))
                return true;

            var searchLower = SearchTerm.ToLowerInvariant();

            return PrinterInfo.IppEndpoint?.ToLowerInvariant().Contains(searchLower) == true ||
                   PrinterInfo.DeviceType?.ToLowerInvariant().Contains(searchLower) == true ||
                   PrinterInfo.Product?.ToLowerInvariant().Contains(searchLower) == true ||
                   PrinterInfo.Note?.ToLowerInvariant().Contains(searchLower) == true ||
                   PrinterInfo.AdminUrl?.ToLowerInvariant().Contains(searchLower) == true ||
                   PrinterInfo.Manufacturer?.ToLowerInvariant().Contains(searchLower) == true ||
                   PrinterInfo.Model?.ToLowerInvariant().Contains(searchLower) == true ||
                   PrinterInfo.ResourcePath?.ToLowerInvariant().Contains(searchLower) == true ||
                   PrinterInfo.UUID?.ToLowerInvariant().Contains(searchLower) == true ||
                   PrinterInfo.SupportedFormats.Any(f => f.ToLowerInvariant().Contains(searchLower)) ||
                   PrinterInfo.Properties.Any(p => p.Key.ToLowerInvariant().Contains(searchLower) ||
                                                    p.Value.ToLowerInvariant().Contains(searchLower));
        }
    }
}
