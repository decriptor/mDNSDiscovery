@using mDNSDiscovery.WebApp.Services.Parsers

@if (HasMatches(ScannerInfo))
{
    <div class="border rounded p-3 mb-3">
        <h5 class="d-flex align-items-center gap-2">
            <i class="bi bi-scanner"></i>
            Network Scanner
            @if (ScannerInfo?.Available == true)
            {
                <span class="badge bg-success">Available</span>
            }
        </h5>

        @if (ScannerInfo != null)
        {
            @if (ScannerInfo.Available)
            {
                <div class="mt-3">
                    @if (!string.IsNullOrEmpty(ScannerInfo.DeviceType))
                    {
                        <div class="mb-2">
                            <strong>Device Type:</strong> @ScannerInfo.DeviceType
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ScannerInfo.AdminUrl))
                    {
                        <div class="mb-2">
                            <strong>Admin URL:</strong>
                            <a href="@ScannerInfo.AdminUrl" target="_blank" class="text-decoration-none">
                                @ScannerInfo.AdminUrl <i class="bi bi-box-arrow-up-right"></i>
                            </a>
                        </div>
                    }

                    @if (ScannerInfo.SupportedFormats.Any())
                    {
                        <div class="mb-2">
                            <strong>Supported Formats:</strong>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var format in ScannerInfo.SupportedFormats)
                                {
                                    <span class="badge bg-secondary">@format</span>
                                }
                            </div>
                        </div>
                    }

                    @if (ScannerInfo.DuplexSupported)
                    {
                        <div class="mb-2">
                            <span class="badge bg-info">
                                <i class="bi bi-arrow-down-up"></i> Duplex Supported
                            </span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ScannerInfo.Note))
                    {
                        <div class="mb-2">
                            <strong>Note:</strong> @ScannerInfo.Note
                        </div>
                    }

                    @if (ScannerInfo.Port > 0)
                    {
                        <div class="mb-2">
                            <strong>Port:</strong> <code>@ScannerInfo.Port</code>
                        </div>
                    }

                    @if (ScannerInfo.Properties.Any())
                    {
                        <details class="mt-3">
                            <summary class="text-muted" style="cursor: pointer;">
                                <small>All Properties (@ScannerInfo.Properties.Count)</small>
                            </summary>
                            <div class="mt-2">
                                <table class="table table-sm table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Key</th>
                                            <th>Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var prop in ScannerInfo.Properties.OrderBy(p => p.Key))
                                        {
                                            <tr>
                                                <td><code>@prop.Key</code></td>
                                                <td><code>@prop.Value</code></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning mt-3 mb-0">
                    <i class="bi bi-exclamation-triangle"></i>
                    Scanner service detected but not available
                </div>
            }
        }
    </div>
}

@code {
    [Parameter] public ScannerInfo? ScannerInfo { get; set; }
    [Parameter] public string? SearchTerm { get; set; }

    private bool HasMatches(ScannerInfo? info)
    {
        if (info == null) return false;

        if (string.IsNullOrWhiteSpace(SearchTerm))
            return true;

        var term = SearchTerm.ToLowerInvariant();

        return info.DeviceType?.ToLowerInvariant().Contains(term) == true ||
               info.AdminUrl?.ToLowerInvariant().Contains(term) == true ||
               info.Note?.ToLowerInvariant().Contains(term) == true ||
               info.SupportedFormats.Any(f => f.ToLowerInvariant().Contains(term)) ||
               info.Properties.Any(p => p.Key.ToLowerInvariant().Contains(term) || p.Value.ToLowerInvariant().Contains(term));
    }
}
