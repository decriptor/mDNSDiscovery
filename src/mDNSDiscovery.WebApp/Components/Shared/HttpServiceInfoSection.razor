@using mDNSDiscovery.WebApp.Services
@using mDNSDiscovery.WebApp.Services.Parsers

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-globe"></i> HTTP Service Information</h5>
    </div>
    <div class="card-body">
        @if (!HasMatches && !string.IsNullOrWhiteSpace(SearchTerm))
        {
            <div class="alert alert-warning mb-0">
                <i class="bi bi-search"></i> No matches found for "<strong>@SearchTerm</strong>"
            </div>
        }
        else
        {
            <dl class="row mb-0">
                @if (!string.IsNullOrEmpty(HttpServiceInfo.Url))
                {
                    <dt class="col-sm-4">Service URL</dt>
                    <dd class="col-sm-8">
                        <a href="@HttpServiceInfo.Url" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-box-arrow-up-right"></i> @HttpServiceInfo.Url
                        </a>
                    </dd>
                }
                @if (HttpServiceInfo.Port > 0)
                {
                    <dt class="col-sm-4">Port</dt>
                    <dd class="col-sm-8">@HttpServiceInfo.Port</dd>
                }
                @if (HttpServiceInfo.IsSecure)
                {
                    <dt class="col-sm-4">Security</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-success"><i class="bi bi-lock-fill"></i> HTTPS (Secure)</span>
                    </dd>
                }
                else
                {
                    <dt class="col-sm-4">Security</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-warning"><i class="bi bi-unlock"></i> HTTP (Unencrypted)</span>
                    </dd>
                }
                @if (!string.IsNullOrEmpty(HttpServiceInfo.Path))
                {
                    <dt class="col-sm-4">Path</dt>
                    <dd class="col-sm-8"><code style="font-size: 0.85rem;">@HttpServiceInfo.Path</code></dd>
                }
                @if (!string.IsNullOrEmpty(HttpServiceInfo.Description))
                {
                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@HttpServiceInfo.Description</dd>
                }
                @if (!string.IsNullOrEmpty(HttpServiceInfo.Version))
                {
                    <dt class="col-sm-4">Version</dt>
                    <dd class="col-sm-8">@HttpServiceInfo.Version</dd>
                }
                @if (HttpServiceInfo.ResponseStatusCode.HasValue)
                {
                    <dt class="col-sm-4">HTTP Status</dt>
                    <dd class="col-sm-8">
                        @if (HttpServiceInfo.ResponseStatusCode >= 200 && HttpServiceInfo.ResponseStatusCode < 300)
                        {
                            <span class="badge bg-success">@HttpServiceInfo.ResponseStatusCode @HttpServiceInfo.ResponseStatus</span>
                        }
                        else if (HttpServiceInfo.ResponseStatusCode >= 300 && HttpServiceInfo.ResponseStatusCode < 400)
                        {
                            <span class="badge bg-info">@HttpServiceInfo.ResponseStatusCode @HttpServiceInfo.ResponseStatus</span>
                        }
                        else if (HttpServiceInfo.ResponseStatusCode >= 400)
                        {
                            <span class="badge bg-danger">@HttpServiceInfo.ResponseStatusCode @HttpServiceInfo.ResponseStatus</span>
                        }
                    </dd>
                }
                @if (!string.IsNullOrEmpty(HttpServiceInfo.ServerType))
                {
                    <dt class="col-sm-4">Server</dt>
                    <dd class="col-sm-8">@HttpServiceInfo.ServerType</dd>
                }
                @if (!string.IsNullOrEmpty(HttpServiceInfo.ContentType))
                {
                    <dt class="col-sm-4">Content Type</dt>
                    <dd class="col-sm-8"><code style="font-size: 0.85rem;">@HttpServiceInfo.ContentType</code></dd>
                }
            </dl>

            @if (HttpServiceInfo.ResponseHeaders.Any())
            {
                <details class="mt-3">
                    <summary class="text-primary" style="cursor: pointer;">View Response Headers</summary>
                    <div class="table-responsive mt-2">
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Header</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var header in HttpServiceInfo.ResponseHeaders.OrderBy(h => h.Key))
                                {
                                    <tr>
                                        <td><code style="font-size: 0.85rem;">@header.Key</code></td>
                                        <td style="word-break: break-all;">@header.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }

            @if (!string.IsNullOrEmpty(HttpServiceInfo.ResponsePreview))
            {
                <details class="mt-3">
                    <summary class="text-primary" style="cursor: pointer;">View Response Preview (First 10KB)</summary>
                    <pre class="mt-2 mb-0 small bg-light p-2 rounded" style="font-size: 0.7rem; max-height: 400px; overflow-y: auto;"><code>@HttpServiceInfo.ResponsePreview</code></pre>
                </details>
            }

            @if (HttpServiceInfo.Properties.Any())
            {
                <details class="mt-3">
                    <summary class="text-primary" style="cursor: pointer;">View All TXT Record Properties</summary>
                    <div class="table-responsive mt-2">
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Property</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prop in HttpServiceInfo.Properties.OrderBy(p => p.Key))
                                {
                                    <tr>
                                        <td><code style="font-size: 0.85rem;">@prop.Key</code></td>
                                        <td>@prop.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public HttpServiceInfo HttpServiceInfo { get; set; } = null!;

    [Parameter]
    public string SearchTerm { get; set; } = string.Empty;

    private bool HasMatches
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchTerm))
                return true;

            var searchLower = SearchTerm.ToLowerInvariant();

            // Search in all text fields
            if (HttpServiceInfo.Url?.ToLowerInvariant().Contains(searchLower) == true ||
                HttpServiceInfo.Path?.ToLowerInvariant().Contains(searchLower) == true ||
                HttpServiceInfo.Description?.ToLowerInvariant().Contains(searchLower) == true ||
                HttpServiceInfo.Version?.ToLowerInvariant().Contains(searchLower) == true ||
                HttpServiceInfo.ServerType?.ToLowerInvariant().Contains(searchLower) == true ||
                HttpServiceInfo.ContentType?.ToLowerInvariant().Contains(searchLower) == true ||
                HttpServiceInfo.ResponseStatus?.ToLowerInvariant().Contains(searchLower) == true ||
                HttpServiceInfo.ResponsePreview?.ToLowerInvariant().Contains(searchLower) == true)
            {
                return true;
            }

            // Search in properties
            foreach (var prop in HttpServiceInfo.Properties)
            {
                if (prop.Key.ToLowerInvariant().Contains(searchLower) ||
                    prop.Value.ToLowerInvariant().Contains(searchLower))
                {
                    return true;
                }
            }

            // Search in response headers
            foreach (var header in HttpServiceInfo.ResponseHeaders)
            {
                if (header.Key.ToLowerInvariant().Contains(searchLower) ||
                    header.Value.ToLowerInvariant().Contains(searchLower))
                {
                    return true;
                }
            }

            return false;
        }
    }
}
