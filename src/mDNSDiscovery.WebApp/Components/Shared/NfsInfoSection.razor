@using mDNSDiscovery.WebApp.Services.Parsers

@if (HasMatches)
{
    <div class="border rounded p-3 mb-3">
        <h5 class="d-flex align-items-center gap-2">
            <i class="bi bi-hdd-network"></i>
            NFS Share
            @if (NfsInfo.Available)
            {
                <span class="badge bg-success">Available</span>
            }
        </h5>

        <div class="mt-3">
            @if (!string.IsNullOrEmpty(NfsInfo.Path))
            {
                <div class="mb-2">
                    <strong>Export Path:</strong> <code>@NfsInfo.Path</code>
                </div>
            }

            @if (NfsInfo.SupportedVersions.Any())
            {
                <div class="mb-2">
                    <strong>NFS Versions:</strong>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var version in NfsInfo.SupportedVersions)
                        {
                            <span class="badge bg-info">NFSv@version</span>
                        }
                    </div>
                </div>
            }

            @if (NfsInfo.SupportedProtocols.Any())
            {
                <div class="mb-2">
                    <strong>Protocols:</strong>
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var protocol in NfsInfo.SupportedProtocols)
                        {
                            <span class="badge bg-secondary">@protocol</span>
                        }
                    </div>
                </div>
            }

            @if (NfsInfo.Port > 0)
            {
                <div class="mb-2">
                    <strong>Port:</strong> <code>@NfsInfo.Port</code>
                </div>
            }

            @if (NfsInfo.Properties.Any())
            {
                <details class="mt-3">
                    <summary class="text-muted" style="cursor: pointer;">
                        <small>All Properties (@NfsInfo.Properties.Count)</small>
                    </summary>
                    <div class="mt-2">
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Key</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prop in NfsInfo.Properties.OrderBy(p => p.Key))
                                {
                                    <tr>
                                        <td><code>@prop.Key</code></td>
                                        <td><code>@prop.Value</code></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }

            <div class="alert alert-info mt-3 mb-0">
                <i class="bi bi-info-circle"></i>
                <strong>About NFS:</strong> Network File System - Unix/Linux network file sharing protocol
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public NfsInfo NfsInfo { get; set; } = null!;
    [Parameter] public string? SearchTerm { get; set; }

    private bool HasMatches
    {
        get
        {
            if (NfsInfo == null) return false;
            if (string.IsNullOrWhiteSpace(SearchTerm)) return true;

            var term = SearchTerm.ToLowerInvariant();

            return NfsInfo.Path?.ToLowerInvariant().Contains(term) == true ||
                   NfsInfo.NfsVersion?.ToLowerInvariant().Contains(term) == true ||
                   NfsInfo.Protocol?.ToLowerInvariant().Contains(term) == true ||
                   NfsInfo.SupportedVersions.Any(v => v.ToLowerInvariant().Contains(term)) ||
                   NfsInfo.SupportedProtocols.Any(p => p.ToLowerInvariant().Contains(term)) ||
                   NfsInfo.Properties.Any(p => p.Key.ToLowerInvariant().Contains(term) ||
                                               p.Value.ToLowerInvariant().Contains(term));
        }
    }
}
