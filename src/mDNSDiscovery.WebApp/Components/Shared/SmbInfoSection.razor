@using mDNSDiscovery.WebApp.Services
@using mDNSDiscovery.WebApp.Services.Parsers

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-hdd-network"></i> SMB File Share Information</h5>
    </div>
    <div class="card-body">
        @if (!HasMatches && !string.IsNullOrWhiteSpace(SearchTerm))
        {
            <div class="alert alert-warning mb-0">
                <i class="bi bi-search"></i> No matches found for "<strong>@SearchTerm</strong>"
            </div>
        }
        else
        {
            <dl class="row mb-0">
                @if (!string.IsNullOrEmpty(SmbInfo.DeviceType))
                {
                    <dt class="col-sm-4">Device Type</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-primary">@SmbInfo.DeviceType</span>
                    </dd>
                }
                @if (!string.IsNullOrEmpty(SmbInfo.ServerName))
                {
                    <dt class="col-sm-4">Server Name</dt>
                    <dd class="col-sm-8">@SmbInfo.ServerName</dd>
                }
                @if (!string.IsNullOrEmpty(SmbInfo.Description))
                {
                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@SmbInfo.Description</dd>
                }
                @if (!string.IsNullOrEmpty(SmbInfo.Workgroup))
                {
                    <dt class="col-sm-4">Workgroup/Domain</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">@SmbInfo.Workgroup</span>
                    </dd>
                }
                @if (SmbInfo.Port > 0)
                {
                    <dt class="col-sm-4">SMB Port</dt>
                    <dd class="col-sm-8">@SmbInfo.Port</dd>
                }
                @if (!string.IsNullOrEmpty(SmbInfo.SmbVersion))
                {
                    <dt class="col-sm-4">SMB Version</dt>
                    <dd class="col-sm-8">@SmbInfo.SmbVersion</dd>
                }
                @if (!string.IsNullOrEmpty(SmbInfo.Version))
                {
                    <dt class="col-sm-4">Server Version</dt>
                    <dd class="col-sm-8">@SmbInfo.Version</dd>
                }
                @if (!string.IsNullOrEmpty(SmbInfo.Authentication))
                {
                    <dt class="col-sm-4">Authentication</dt>
                    <dd class="col-sm-8">@SmbInfo.Authentication</dd>
                }
                @if (SmbInfo.GuestAccessEnabled)
                {
                    <dt class="col-sm-4">Guest Access</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-warning">Enabled</span>
                        <small class="text-muted ms-2">(Anonymous access allowed)</small>
                    </dd>
                }
            </dl>

            @if (SmbInfo.Shares.Any())
            {
                <div class="mt-3">
                    <h6><i class="bi bi-folder2-open"></i> Available Shares:</h6>
                    <ul class="list-group list-group-flush">
                        @foreach (var share in SmbInfo.Shares)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span><i class="bi bi-folder"></i> @share</span>
                                <code class="small">smb://@DeviceIpAddress/@share</code>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (SmbInfo.Properties.Any())
            {
                <details class="mt-3">
                    <summary class="text-primary" style="cursor: pointer;">View All TXT Record Properties</summary>
                    <div class="table-responsive mt-2">
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Property</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prop in SmbInfo.Properties.OrderBy(p => p.Key))
                                {
                                    <tr>
                                        <td><code style="font-size: 0.85rem;">@prop.Key</code></td>
                                        <td>@prop.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }

            <div class="alert alert-info mt-3 mb-0">
                <i class="bi bi-info-circle"></i>
                <strong>Connect to this file server:</strong>
                @if (SmbInfo.Port == 445)
                {
                    <br/><strong>Windows:</strong> <code class="mt-1 d-inline-block">\\@DeviceIpAddress\share</code>
                    <br/><strong>macOS/Linux:</strong> <code class="mt-1 d-inline-block">smb://@DeviceIpAddress/share</code>
                }
                else
                {
                    <br/><strong>Custom Port:</strong> <code class="mt-1 d-inline-block">smb://@DeviceIpAddress:@SmbInfo.Port/share</code>
                }
                @if (SmbInfo.GuestAccessEnabled)
                {
                    <br/><small class="text-muted">Guest access is enabled - you may be able to connect without credentials.</small>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public SmbInfo SmbInfo { get; set; } = null!;

    [Parameter]
    public string SearchTerm { get; set; } = string.Empty;

    [Parameter]
    public string DeviceIpAddress { get; set; } = string.Empty;

    private bool HasMatches
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchTerm))
                return true;

            var searchLower = SearchTerm.ToLowerInvariant();

            // Search in all text fields
            if (SmbInfo.DeviceType?.ToLowerInvariant().Contains(searchLower) == true ||
                SmbInfo.ServerName?.ToLowerInvariant().Contains(searchLower) == true ||
                SmbInfo.Description?.ToLowerInvariant().Contains(searchLower) == true ||
                SmbInfo.Workgroup?.ToLowerInvariant().Contains(searchLower) == true ||
                SmbInfo.Version?.ToLowerInvariant().Contains(searchLower) == true ||
                SmbInfo.SmbVersion?.ToLowerInvariant().Contains(searchLower) == true ||
                SmbInfo.Authentication?.ToLowerInvariant().Contains(searchLower) == true)
            {
                return true;
            }

            // Search in shares
            if (SmbInfo.Shares.Any(s => s.ToLowerInvariant().Contains(searchLower)))
            {
                return true;
            }

            // Search in properties
            foreach (var prop in SmbInfo.Properties)
            {
                if (prop.Key.ToLowerInvariant().Contains(searchLower) ||
                    prop.Value.ToLowerInvariant().Contains(searchLower))
                {
                    return true;
                }
            }

            return false;
        }
    }
}
