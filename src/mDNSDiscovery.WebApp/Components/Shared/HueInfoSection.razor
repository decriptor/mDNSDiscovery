@using mDNSDiscovery.WebApp.Services
@using mDNSDiscovery.WebApp.Services.Parsers

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-lightbulb"></i> Philips Hue Bridge</h5>
    </div>
    <div class="card-body">
        @if (!HasMatches && !string.IsNullOrWhiteSpace(SearchTerm))
        {
            <div class="alert alert-warning mb-0">
                <i class="bi bi-search"></i> No matches found for "<strong>@SearchTerm</strong>"
            </div>
        }
        else
        {
            <dl class="row mb-0">
                @if (!string.IsNullOrEmpty(HueInfo.BridgeName))
                {
                    <dt class="col-sm-4">Bridge Name</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-primary">@HueInfo.BridgeName</span>
                    </dd>
                }
                @if (!string.IsNullOrEmpty(HueInfo.BridgeId))
                {
                    <dt class="col-sm-4">Bridge ID</dt>
                    <dd class="col-sm-8">
                        <code style="font-size: 0.85rem;">@HueInfo.BridgeId</code>
                    </dd>
                }
                @if (!string.IsNullOrEmpty(HueInfo.ModelId))
                {
                    <dt class="col-sm-4">Model ID</dt>
                    <dd class="col-sm-8">@HueInfo.ModelId</dd>
                }
                @if (HueInfo.Port > 0)
                {
                    <dt class="col-sm-4">API Port</dt>
                    <dd class="col-sm-8">@HueInfo.Port</dd>
                }
                @if (!string.IsNullOrEmpty(HueInfo.ApiVersion))
                {
                    <dt class="col-sm-4">API Version</dt>
                    <dd class="col-sm-8">@HueInfo.ApiVersion</dd>
                }
                @if (!string.IsNullOrEmpty(HueInfo.SoftwareVersion))
                {
                    <dt class="col-sm-4">Software Version</dt>
                    <dd class="col-sm-8">@HueInfo.SoftwareVersion</dd>
                }
            </dl>

            @if (HueInfo.Properties.Any())
            {
                <details class="mt-3">
                    <summary class="text-primary" style="cursor: pointer;">View All TXT Record Properties</summary>
                    <div class="table-responsive mt-2">
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Property</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prop in HueInfo.Properties.OrderBy(p => p.Key))
                                {
                                    <tr>
                                        <td><code style="font-size: 0.85rem;">@prop.Key</code></td>
                                        <td>@prop.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }

            @if (!string.IsNullOrEmpty(HueInfo.ApiResponse))
            {
                <details class="mt-3">
                    <summary class="text-primary" style="cursor: pointer;">View API Response (Unauthenticated)</summary>
                    <pre class="mt-2 mb-0 small bg-light p-2 rounded" style="font-size: 0.7rem; max-height: 300px; overflow-y: auto;"><code>@HueInfo.ApiResponse</code></pre>
                </details>
            }

            <div class="alert alert-info mt-3 mb-0">
                <i class="bi bi-info-circle"></i>
                <strong>About Philips Hue:</strong> This is a Philips Hue Bridge that controls smart lighting devices.
                To control your lights, you'll need to register an application with the bridge and obtain an API key.
                Visit the <a href="https://developers.meethue.com/" target="_blank" class="alert-link">Philips Hue Developer Portal</a> for more information.
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public HueInfo HueInfo { get; set; } = null!;

    [Parameter]
    public string SearchTerm { get; set; } = string.Empty;

    private bool HasMatches
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchTerm))
                return true;

            var searchLower = SearchTerm.ToLowerInvariant();

            // Search in all text fields
            if (HueInfo.BridgeName?.ToLowerInvariant().Contains(searchLower) == true ||
                HueInfo.BridgeId?.ToLowerInvariant().Contains(searchLower) == true ||
                HueInfo.ModelId?.ToLowerInvariant().Contains(searchLower) == true ||
                HueInfo.ApiVersion?.ToLowerInvariant().Contains(searchLower) == true ||
                HueInfo.SoftwareVersion?.ToLowerInvariant().Contains(searchLower) == true ||
                HueInfo.ApiResponse?.ToLowerInvariant().Contains(searchLower) == true)
            {
                return true;
            }

            // Search in properties
            foreach (var prop in HueInfo.Properties)
            {
                if (prop.Key.ToLowerInvariant().Contains(searchLower) ||
                    prop.Value.ToLowerInvariant().Contains(searchLower))
                {
                    return true;
                }
            }

            return false;
        }
    }
}
