@using mDNSDiscovery.WebApp.Services
@using mDNSDiscovery.WebApp.Services.Parsers

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-house-heart"></i> HomeKit Information</h5>
    </div>
    <div class="card-body">
        @if (!HasMatches && !string.IsNullOrWhiteSpace(SearchTerm))
        {
            <div class="alert alert-warning mb-0">
                <i class="bi bi-search"></i> No matches found for "<strong>@SearchTerm</strong>"
            </div>
        }
        else
        {
            <dl class="row mb-0">
                @if (!string.IsNullOrEmpty(HomeKitInfo.Category))
                {
                    <dt class="col-sm-4">Device Category</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-primary">@HomeKitInfo.Category</span>
                    </dd>
                }
                @if (!string.IsNullOrEmpty(HomeKitInfo.ModelName))
                {
                    <dt class="col-sm-4">Model</dt>
                    <dd class="col-sm-8">@HomeKitInfo.ModelName</dd>
                }
                @if (!string.IsNullOrEmpty(HomeKitInfo.DeviceId))
                {
                    <dt class="col-sm-4">Device ID</dt>
                    <dd class="col-sm-8"><code style="font-size: 0.85rem;">@HomeKitInfo.DeviceId</code></dd>
                }
                @if (!string.IsNullOrEmpty(HomeKitInfo.ProtocolVersion))
                {
                    <dt class="col-sm-4">HAP Protocol Version</dt>
                    <dd class="col-sm-8">@HomeKitInfo.ProtocolVersion</dd>
                }
                @if (!string.IsNullOrEmpty(HomeKitInfo.ConfigurationNumber))
                {
                    <dt class="col-sm-4">Configuration Number</dt>
                    <dd class="col-sm-8">@HomeKitInfo.ConfigurationNumber</dd>
                }
                @if (!string.IsNullOrEmpty(HomeKitInfo.StateNumber))
                {
                    <dt class="col-sm-4">State Number</dt>
                    <dd class="col-sm-8">@HomeKitInfo.StateNumber</dd>
                }
                @if (HomeKitInfo.StatusFlagsDecoded.Any())
                {
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @foreach (var flag in HomeKitInfo.StatusFlagsDecoded)
                        {
                            <span class="badge bg-warning text-dark me-1">@flag</span>
                        }
                    </dd>
                }
                @if (HomeKitInfo.FeatureFlagsDecoded.Any())
                {
                    <dt class="col-sm-4">Features</dt>
                    <dd class="col-sm-8">
                        @foreach (var flag in HomeKitInfo.FeatureFlagsDecoded)
                        {
                            <span class="badge bg-info me-1">@flag</span>
                        }
                    </dd>
                }
                @if (HomeKitInfo.Port > 0)
                {
                    <dt class="col-sm-4">HAP Port</dt>
                    <dd class="col-sm-8">@HomeKitInfo.Port</dd>
                }
            </dl>

            @if (HomeKitInfo.Properties.Any())
            {
                <details class="mt-3">
                    <summary class="text-primary" style="cursor: pointer;">View All TXT Record Properties</summary>
                    <div class="table-responsive mt-2">
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Property</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prop in HomeKitInfo.Properties.OrderBy(p => p.Key))
                                {
                                    <tr>
                                        <td><code style="font-size: 0.85rem;">@prop.Key</code></td>
                                        <td>@prop.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }

            <div class="alert alert-info mt-3 mb-0">
                <i class="bi bi-info-circle"></i>
                <strong>Note:</strong> HomeKit devices use encrypted communication and require pairing with the Home app.
                Additional device details are only accessible after pairing.
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public HomeKitInfo HomeKitInfo { get; set; } = null!;

    [Parameter]
    public string SearchTerm { get; set; } = string.Empty;

    private bool HasMatches
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchTerm))
                return true;

            var searchLower = SearchTerm.ToLowerInvariant();

            // Search in all text fields
            if (HomeKitInfo.Category?.ToLowerInvariant().Contains(searchLower) == true ||
                HomeKitInfo.ModelName?.ToLowerInvariant().Contains(searchLower) == true ||
                HomeKitInfo.DeviceId?.ToLowerInvariant().Contains(searchLower) == true ||
                HomeKitInfo.ProtocolVersion?.ToLowerInvariant().Contains(searchLower) == true ||
                HomeKitInfo.ConfigurationNumber?.ToLowerInvariant().Contains(searchLower) == true ||
                HomeKitInfo.StateNumber?.ToLowerInvariant().Contains(searchLower) == true ||
                HomeKitInfo.SetupHash?.ToLowerInvariant().Contains(searchLower) == true)
            {
                return true;
            }

            // Search in status flags
            if (HomeKitInfo.StatusFlagsDecoded.Any(f => f.ToLowerInvariant().Contains(searchLower)))
                return true;

            // Search in feature flags
            if (HomeKitInfo.FeatureFlagsDecoded.Any(f => f.ToLowerInvariant().Contains(searchLower)))
                return true;

            // Search in properties
            foreach (var prop in HomeKitInfo.Properties)
            {
                if (prop.Key.ToLowerInvariant().Contains(searchLower) ||
                    prop.Value.ToLowerInvariant().Contains(searchLower))
                {
                    return true;
                }
            }

            return false;
        }
    }
}
