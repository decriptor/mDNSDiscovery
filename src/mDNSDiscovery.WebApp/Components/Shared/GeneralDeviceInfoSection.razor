@using mDNSDiscovery.WebApp.Services
@using mDNSDiscovery.WebApp.Services.Parsers

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-info-circle"></i> General Device Information</h5>
    </div>
    <div class="card-body">
        @if (!HasMatches && !string.IsNullOrWhiteSpace(SearchTerm))
        {
            <div class="alert alert-warning mb-0">
                <i class="bi bi-search"></i> No matches found for "<strong>@SearchTerm</strong>"
            </div>
        }
        else
        {
            <dl class="row mb-0">
                @if (!string.IsNullOrEmpty(DeviceInfo.Manufacturer))
                {
                    <dt class="col-sm-4">Manufacturer</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-primary">@DeviceInfo.Manufacturer</span>
                    </dd>
                }
                @if (!string.IsNullOrEmpty(DeviceInfo.Model))
                {
                    <dt class="col-sm-4">Model</dt>
                    <dd class="col-sm-8">@DeviceInfo.Model</dd>
                }
                @if (!string.IsNullOrEmpty(DeviceInfo.DeviceType))
                {
                    <dt class="col-sm-4">Device Type</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">@DeviceInfo.DeviceType</span>
                    </dd>
                }
                @if (!string.IsNullOrEmpty(DeviceInfo.Description))
                {
                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@DeviceInfo.Description</dd>
                }
                @if (!string.IsNullOrEmpty(DeviceInfo.SerialNumber))
                {
                    <dt class="col-sm-4">Serial Number</dt>
                    <dd class="col-sm-8">
                        <code style="font-size: 0.85rem;">@DeviceInfo.SerialNumber</code>
                    </dd>
                }
                @if (!string.IsNullOrEmpty(DeviceInfo.DeviceId))
                {
                    <dt class="col-sm-4">Device ID</dt>
                    <dd class="col-sm-8">
                        <code style="font-size: 0.85rem;">@DeviceInfo.DeviceId</code>
                    </dd>
                }
                @if (!string.IsNullOrEmpty(DeviceInfo.FirmwareVersion))
                {
                    <dt class="col-sm-4">Firmware Version</dt>
                    <dd class="col-sm-8">@DeviceInfo.FirmwareVersion</dd>
                }
                @if (!string.IsNullOrEmpty(DeviceInfo.HardwareVersion))
                {
                    <dt class="col-sm-4">Hardware Version</dt>
                    <dd class="col-sm-8">@DeviceInfo.HardwareVersion</dd>
                }
                @if (!string.IsNullOrEmpty(DeviceInfo.OSVersion))
                {
                    <dt class="col-sm-4">OS Version</dt>
                    <dd class="col-sm-8">@DeviceInfo.OSVersion</dd>
                }
                @if (DeviceInfo.Features.Any())
                {
                    <dt class="col-sm-4">Features</dt>
                    <dd class="col-sm-8">
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var feature in DeviceInfo.Features)
                            {
                                <span class="badge bg-info">@feature</span>
                            }
                        </div>
                    </dd>
                }
            </dl>

            @if (DeviceInfo.Properties.Any())
            {
                <details class="mt-3">
                    <summary class="text-primary" style="cursor: pointer;">View All TXT Record Properties</summary>
                    <div class="table-responsive mt-2">
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Property</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prop in DeviceInfo.Properties.OrderBy(p => p.Key))
                                {
                                    <tr>
                                        <td><code style="font-size: 0.85rem;">@prop.Key</code></td>
                                        <td>@prop.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public GeneralDeviceInfo DeviceInfo { get; set; } = null!;

    [Parameter]
    public string SearchTerm { get; set; } = string.Empty;

    private bool HasMatches
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchTerm))
                return true;

            var searchLower = SearchTerm.ToLowerInvariant();

            // Search in all text fields
            if (DeviceInfo.Manufacturer?.ToLowerInvariant().Contains(searchLower) == true ||
                DeviceInfo.Model?.ToLowerInvariant().Contains(searchLower) == true ||
                DeviceInfo.DeviceType?.ToLowerInvariant().Contains(searchLower) == true ||
                DeviceInfo.Description?.ToLowerInvariant().Contains(searchLower) == true ||
                DeviceInfo.SerialNumber?.ToLowerInvariant().Contains(searchLower) == true ||
                DeviceInfo.DeviceId?.ToLowerInvariant().Contains(searchLower) == true ||
                DeviceInfo.FirmwareVersion?.ToLowerInvariant().Contains(searchLower) == true ||
                DeviceInfo.HardwareVersion?.ToLowerInvariant().Contains(searchLower) == true ||
                DeviceInfo.OSVersion?.ToLowerInvariant().Contains(searchLower) == true)
            {
                return true;
            }

            // Search in features
            if (DeviceInfo.Features.Any(f => f.ToLowerInvariant().Contains(searchLower)))
            {
                return true;
            }

            // Search in properties
            foreach (var prop in DeviceInfo.Properties)
            {
                if (prop.Key.ToLowerInvariant().Contains(searchLower) ||
                    prop.Value.ToLowerInvariant().Contains(searchLower))
                {
                    return true;
                }
            }

            return false;
        }
    }
}
