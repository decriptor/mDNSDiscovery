@using mDNSDiscovery.WebApp.Services.Parsers

@if (HasMatches(ADiskInfo))
{
    <div class="border rounded p-3 mb-3">
        <h5 class="d-flex align-items-center gap-2">
            <i class="bi bi-clock-history"></i>
            Time Machine / Airport Disk
            @if (ADiskInfo?.Available == true)
            {
                <span class="badge bg-success">Available</span>
            }
        </h5>

        @if (ADiskInfo != null)
        {
            @if (ADiskInfo.Available)
            {
                <div class="mt-3">
                    @if (!string.IsNullOrEmpty(ADiskInfo.VolumeName))
                    {
                        <div class="mb-2">
                            <strong>Volume Name:</strong> <code>@ADiskInfo.VolumeName</code>
                        </div>
                    }

                    @if (ADiskInfo.DecodedSystemFlags.Any())
                    {
                        <div class="mb-2">
                            <strong>System Capabilities:</strong>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var flag in ADiskInfo.DecodedSystemFlags)
                                {
                                    <span class="badge bg-primary">@flag</span>
                                }
                            </div>
                        </div>
                    }

                    @if (ADiskInfo.DecodedVolumeFlags.Any())
                    {
                        <div class="mb-2">
                            <strong>Volume Features:</strong>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var flag in ADiskInfo.DecodedVolumeFlags)
                                {
                                    <span class="badge bg-info">@flag</span>
                                }
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ADiskInfo.WakeMAAddress))
                    {
                        <div class="mb-2">
                            <strong>Wake MAC Address:</strong> <code>@ADiskInfo.WakeMAAddress</code>
                        </div>
                    }

                    @if (ADiskInfo.Port > 0)
                    {
                        <div class="mb-2">
                            <strong>Port:</strong> <code>@ADiskInfo.Port</code>
                        </div>
                    }

                    @if (ADiskInfo.Properties.Any())
                    {
                        <details class="mt-3">
                            <summary class="text-muted" style="cursor: pointer;">
                                <small>All Properties (@ADiskInfo.Properties.Count)</small>
                            </summary>
                            <div class="mt-2">
                                <table class="table table-sm table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Key</th>
                                            <th>Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var prop in ADiskInfo.Properties.OrderBy(p => p.Key))
                                        {
                                            <tr>
                                                <td><code>@prop.Key</code></td>
                                                <td><code>@prop.Value</code></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning mt-3 mb-0">
                    <i class="bi bi-exclamation-triangle"></i>
                    ADisk service detected but not available
                </div>
            }
        }
    </div>
}

@code {
    [Parameter] public ADiskInfo? ADiskInfo { get; set; }
    [Parameter] public string? SearchTerm { get; set; }

    private bool HasMatches(ADiskInfo? info)
    {
        if (info == null) return false;

        if (string.IsNullOrWhiteSpace(SearchTerm))
            return true;

        var term = SearchTerm.ToLowerInvariant();

        return info.VolumeName?.ToLowerInvariant().Contains(term) == true ||
               info.WakeMAAddress?.ToLowerInvariant().Contains(term) == true ||
               info.DecodedSystemFlags.Any(f => f.ToLowerInvariant().Contains(term)) ||
               info.DecodedVolumeFlags.Any(f => f.ToLowerInvariant().Contains(term)) ||
               info.Properties.Any(p => p.Key.ToLowerInvariant().Contains(term) || p.Value.ToLowerInvariant().Contains(term));
    }
}
