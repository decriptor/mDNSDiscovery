@using mDNSDiscovery.WebApp.Services
@using mDNSDiscovery.WebApp.Services.Parsers
@using mDNSDiscovery.WebApp.Components.Shared

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-apple"></i> AirPlay Information</h5>
    </div>
    <div class="card-body">
        @if (!HasMatches && !string.IsNullOrWhiteSpace(SearchTerm))
        {
            <div class="alert alert-warning mb-0">
                <i class="bi bi-search"></i> No matches found for "<strong>@SearchTerm</strong>"
            </div>
        }
        else
        {
            <p class="mb-2">Found @AppleInfo.Endpoints.Count AirPlay endpoint(s).</p>

        @foreach (var endpoint in AppleInfo.Endpoints)
        {
            <div class="mb-3 p-3 border rounded">
                <h6>
                    <i class="bi bi-broadcast"></i> Port @endpoint.Port
                </h6>

                @if (endpoint.ParsedData != null)
                {
                    <dl class="row mt-3 mb-0">
                        @if (endpoint.ParsedData.ContainsKey("name"))
                        {
                            <dt class="col-sm-4">Name</dt>
                            <dd class="col-sm-8">@endpoint.ParsedData["name"]</dd>
                        }
                        @if (endpoint.ParsedData.ContainsKey("model"))
                        {
                            <dt class="col-sm-4">Model</dt>
                            <dd class="col-sm-8">@endpoint.ParsedData["model"]</dd>
                        }
                        @if (endpoint.ParsedData.ContainsKey("deviceID"))
                        {
                            <dt class="col-sm-4">Device ID</dt>
                            <dd class="col-sm-8"><code style="font-size: 0.85rem;">@endpoint.ParsedData["deviceID"]</code></dd>
                        }
                        @if (endpoint.ParsedData.ContainsKey("macAddress"))
                        {
                            <dt class="col-sm-4">MAC Address</dt>
                            <dd class="col-sm-8"><code style="font-size: 0.85rem;">@endpoint.ParsedData["macAddress"]</code></dd>
                        }
                        @if (endpoint.ParsedData.ContainsKey("sourceVersion"))
                        {
                            <dt class="col-sm-4">Source Version</dt>
                            <dd class="col-sm-8">@endpoint.ParsedData["sourceVersion"]</dd>
                        }
                        @if (endpoint.ParsedData.ContainsKey("osBuildVersion"))
                        {
                            <dt class="col-sm-4">OS Build</dt>
                            <dd class="col-sm-8">@endpoint.ParsedData["osBuildVersion"]</dd>
                        }
                        @if (endpoint.ParsedData.ContainsKey("protocolVersion"))
                        {
                            <dt class="col-sm-4">Protocol Version</dt>
                            <dd class="col-sm-8">@endpoint.ParsedData["protocolVersion"]</dd>
                        }
                        @if (endpoint.ParsedData.ContainsKey("features"))
                        {
                            var featuresHex = endpoint.ParsedData["features"]?.ToString() ?? "";
                            var decodedFeatures = AirPlayHelper.DecodeFeatures(featuresHex);

                            @if (decodedFeatures.Any())
                            {
                                <dt class="col-sm-4">Features</dt>
                                <dd class="col-sm-8">
                                    <details class="mt-1">
                                        <summary class="text-info" style="cursor: pointer; font-size: 0.85rem;">
                                            <i class="bi bi-list-ul"></i> @decodedFeatures.Count Capabilities
                                        </summary>
                                        <ul class="mt-2 mb-0 small">
                                            @foreach (var feature in decodedFeatures)
                                            {
                                                <li>@feature</li>
                                            }
                                        </ul>
                                    </details>
                                </dd>
                            }
                        }
                        @if (endpoint.ParsedData.ContainsKey("statusFlags"))
                        {
                            var statusFlagsHex = endpoint.ParsedData["statusFlags"]?.ToString() ?? "";
                            var decodedFlags = AirPlayHelper.DecodeStatusFlags(statusFlagsHex);

                            @if (decodedFlags.Any())
                            {
                                <dt class="col-sm-4">Status Flags</dt>
                                <dd class="col-sm-8">
                                    <details class="mt-1">
                                        <summary class="text-info" style="cursor: pointer; font-size: 0.85rem;">
                                            <i class="bi bi-flag"></i> @decodedFlags.Count Active Flags
                                        </summary>
                                        <ul class="mt-2 mb-0 small">
                                            @foreach (var flag in decodedFlags)
                                            {
                                                <li>@flag</li>
                                            }
                                        </ul>
                                    </details>
                                </dd>
                            }
                        }
                    </dl>

                    <details class="mt-3">
                        <summary class="text-primary" style="cursor: pointer;">View All Parsed Data</summary>
                        <div class="mt-2 p-3 bg-light border rounded">
                            <ParsedDataTable Data="@endpoint.ParsedData" Level="0" />
                        </div>
                    </details>
                }

                @if (!string.IsNullOrEmpty(endpoint.RawData))
                {
                    <details class="mt-2">
                        <summary class="text-primary" style="cursor: pointer;">View Raw Binary Data</summary>
                        <pre class="mt-2 p-3 bg-light border rounded" style="font-size: 0.75rem; max-height: 300px; overflow-y: auto;"><code>@endpoint.RawData</code></pre>
                    </details>
                }
            </div>
        }
        }
    </div>
</div>

@code {
    [Parameter]
    public AirPlayInfo AppleInfo { get; set; } = null!;

    [Parameter]
    public string SearchTerm { get; set; } = string.Empty;

    private bool HasMatches
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchTerm))
                return true;

            var searchLower = SearchTerm.ToLowerInvariant();

            // Search in all endpoints
            foreach (var endpoint in AppleInfo.Endpoints)
            {
                // Search in raw data
                if (endpoint.RawData?.ToLowerInvariant().Contains(searchLower) == true)
                    return true;

                // Search in parsed data
                if (endpoint.ParsedData != null && SearchInParsedData(endpoint.ParsedData, searchLower))
                    return true;
            }

            return false;
        }
    }

    private bool SearchInParsedData(Dictionary<string, object> data, string searchTerm)
    {
        foreach (var kvp in data)
        {
            // Search in key
            if (kvp.Key.ToLowerInvariant().Contains(searchTerm))
                return true;

            // Search in value
            if (kvp.Value != null)
            {
                if (kvp.Value is string str && str.ToLowerInvariant().Contains(searchTerm))
                    return true;

                if (kvp.Value is Dictionary<string, object> dict && SearchInParsedData(dict, searchTerm))
                    return true;

                if (kvp.Value.ToString()?.ToLowerInvariant().Contains(searchTerm) == true)
                    return true;
            }
        }
        return false;
    }
}
